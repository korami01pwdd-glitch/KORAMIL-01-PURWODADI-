            <div class="bg-army-700 text-white py-4 px-6 text-center border-b-4 border-gold-500">
                <h2 class="text-xl font-bold uppercase tracking-wide text-gold-500">LOGIN PORTAL RESMI</h2>
                <p class="text-xs text-gray-300 mt-1">koramil01purwodadi.my.id</p>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-army-700 mb-1">Pilih Akun / Personil</label>
                    <select id="loginSelect" class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-army-600 focus:outline-none bg-gray-50">
                        <option value="">-- Pilih Nama & Pangkat --</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-army-700 mb-1">Kata Sandi</label>
                    <input type="password" id="loginPassword" placeholder="Masukkan password (default: Anggota123)" class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-army-600 focus:outline-none bg-gray-50">
                </div>
                <button onclick="login()" class="w-full bg-army-700 hover:bg-army-800 text-gold-500 font-bold py-3 rounded-lg shadow uppercase tracking-wider text-sm transition border border-gold-500">
                    <i class="fa-solid fa-lock-open mr-2"></i> Masuk Portal
                </button>
                <div class="bg-amber-50 border-l-4 border-gold-500 p-3 text-xs text-amber-800">
                    <span class="font-bold">Info Demo:</span> Danramil / Batuud login dengan sandi <code>Admin123</code>. Babinsa menggunakan sandi default <code>Anggota123</code>.
                </div>
            </div>
        </div>

