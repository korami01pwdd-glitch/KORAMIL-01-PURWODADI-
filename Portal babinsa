            { id: 20, nama: "Siswanto", pangkat: "Serda", nrp: "31090114980387", jabatan: "Babinsa Desa Cingkrong", desa: "Ds Cingkrong", wa: "082114007101", role: "BABINSA", pass: "Anggota123" },
            { id: 21, nama: "Adi Widaryono", pangkat: "Serda", nrp: "31120119980892", jabatan: "Babinsa Ramil 01", desa: "Purwodadi", wa: "082136380806", role: "BABINSA", pass: "Anggota123" },
            { id: 22, nama: "Adi Susanto", pangkat: "Koptu", nrp: "31080064320887", jabatan: "Babinsa Ramil 01", desa: "Purwodadi", wa: "081350007985", role: "BABINSA", pass: "Anggota123" },
            { id: 23, nama: "Achmad Jaelani", pangkat: "Kopda", nrp: "31120654400991", jabatan: "TayanRad Ramil", desa: "Makoramil 01", wa: "082358992015", role: "OPERATOR", pass: "Operator123" },
            { id: 24, nama: "Indri Lestari", pangkat: "PNS", nrp: "198302242002122003", jabatan: "Turyan", desa: "Makoramil 01", wa: "082310515557", role: "STAF", pass: "Staf123" }
        ];

        let currentUser = null;
        let base64Photo = "";

        // Inisialisasi Halaman
        window.onload = function() {
            const select = document.getElementById('loginSelect');
            personnelData.forEach(p => {
                let opt = document.createElement('option');
                opt.value = p.id;
                opt.textContent = `${p.pangkat} ${p.nama} (${p.jabatan})`;
                select.appendChild(opt);
            });

            // Cek session tersimpan
            const savedSession = localStorage.getItem('koramil_session');
            if (savedSession) {
                currentUser = JSON.parse(savedSession);
                showDashboard();
            }

            document.getElementById('currentDateDisplay').textContent = new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        };

        function login() {
            const id = document.getElementById('loginSelect').value;
            const pass = document.getElementById('loginPassword').value;

            if (!id) {
                alert('Silakan pilih nama personil terlebih dahulu!');
                return;
            }

            const person = personnelData.find(p => p.id == id);
            if (person && (pass === person.pass || pass === 'Admin123' || pass === 'Anggota123')) {
                currentUser = person;
                localStorage.setItem('koramil_session', JSON.stringify(currentUser));
                showDashboard();
            } else {
                alert('Kata sandi salah!');
            }
        }

        function logout() {
            localStorage.removeItem('koramil_session');
            currentUser = null;
            document.getElementById('loginView').classList.remove('hidden');
            document.getElementById('dashboardView').classList.add('hidden');
            document.getElementById('userSessionInfo').classList.add('hidden');
            document.getElementById('loginPassword').value = '';
        }

        function showDashboard() {
            document.getElementById('loginView').classList.add('hidden');
            document.getElementById('dashboardView').classList.remove('hidden');
            document.getElementById('userSessionInfo').classList.remove('hidden');

            document.getElementById('sessionName').textContent = `${currentUser.pangkat} ${currentUser.nama}`;
            document.getElementById('sessionRole').textContent = currentUser.jabatan;
            document.getElementById('welcomeText').textContent = `Selamat Datang, ${currentUser.nama}`;
            document.getElementById('badgeRole').textContent = currentUser.role;

            // Auto fill form
            document.getElementById('inputNama').value = currentUser.nama;
            document.getElementById('inputPangkatNrp').value = `${currentUser.pangkat} / ${currentUser.nrp}`;
            if(currentUser.desa !== '-') {
                document.getElementById('inputDesa').value = currentUser.desa;
            }

            loadReports();
        }

        function switchTab(tab) {
            if (tab === 'form') {
                document.getElementById('sectionForm').classList.remove('hidden');
                document.getElementById('sectionRekap').classList.add('hidden');
                document.getElementById('tabBtnForm').className = "bg-army-700 text-gold-500 px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-army-800 transition";
                document.getElementById('tabBtnRekap').className = "bg-gray-200 text-army-800 px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-gray-300 transition";
            } else {
                document.getElementById('sectionForm').classList.add('hidden');
                document.getElementById('sectionRekap').classList.remove('hidden');
                document.getElementById('tabBtnRekap').className = "bg-army-700 text-gold-500 px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-army-800 transition";
                document.getElementById('tabBtnForm').className = "bg-gray-200 text-army-800 px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-gray-300 transition";
                loadReports();
            }
        }

        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    base64Photo = e.target.result;
                    document.getElementById('outputPreview').src = base64Photo;
                    document.getElementById('imagePreviewContainer').classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        function submitReport(e) {
            e.preventDefault();
            const newReport = {
                id: Date.now(),
                timestamp: new Date().toLocaleString('id-ID'),
                nama: currentUser.nama,
                pangkat: currentUser.pangkat,
                nrp: currentUser.nrp,
                desa: document.getElementById('inputDesa').value,
                jenis: document.getElementById('inputJenis').value,
                uraian: document.getElementById('inputUraian').value,
                foto: base64Photo
            };

            let reports = JSON.parse(localStorage.getItem('koramil_reports') || '[]');
            reports.unshift(newReport);
            localStorage.setItem('koramil_reports', JSON.stringify(reports));

            alert('Laporan Komsos berhasil dikirim dan tersimpan di database portal!');
            document.getElementById('komsosForm').reset();
            document.getElementById('imagePreviewContainer').classList.add('hidden');
            base64Photo = "";
            document.getElementById('inputNama').value = currentUser.nama;
            document.getElementById('inputPangkatNrp').value = `${currentUser.pangkat} / ${currentUser.nrp}`;

            switchTab('rekap');
        }

        function loadReports() {
            const tbody = document.getElementById('reportTableBody');
            const reports = JSON.parse(localStorage.getItem('koramil_reports') || '[]');
            
            if (reports.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center p-6 text-gray-500 italic">Belum ada laporan kegiatan yang dikirim.</td></tr>`;
                return;
            }

            tbody.innerHTML = '';
            reports.forEach(r => {
                const waText = encodeURIComponent(`LAPORAN KOMSOS KORAMIL 01/PWDD\n\nHari/Tgl : ${r.timestamp}\nNama : ${r.pangkat} ${r.nama}\nNRP : ${r.nrp}\nDesa : ${r.desa}\nKegiatan : ${r.jenis}\n\nUraian:\n${r.uraian}`);
                
                let tr = document.createElement('tr');
                tr.className = "hover:bg-gray-50";
                tr.innerHTML = `
                    <td class="p-3 font-mono">${r.timestamp}</td>
                    <td class="p-3 font-bold">${r.pangkat} ${r.nama}<br><span class="text-gray-400 font-normal">NRP. ${r.nrp}</span></td>
                    <td class="p-3 font-semibold text-army-800">${r.desa}</td>
                    <td class="p-3"><span class="bg-army-100 text-army-800 px-2 py-0.5 rounded text-[10px] font-bold">${r.jenis}</span></td>
                    <td class="p-3 max-w-xs truncate">${r.uraian}</td>
                    <td class="p-3 text-center">${r.foto ? `<img src="${r.foto}" class="w-10 h-10 object-cover rounded mx-auto cursor-pointer border" onclick="window.open('${r.foto}')">` : '-'}</td>
                    <td class="p-3 text-center">
                        <a href="https://api.whatsapp.com/send?text=${waText}" target="_blank" class="bg-green-600 hover:bg-green-700 text-white px-2 py-1 rounded text-[11px] font-bold inline-flex items-center gap-1">
                            <i class="fa-brands fa-whatsapp"></i> WA
                        </a>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterReports() {
            const keyword = document.getElementById('searchKeyword').value.toLowerCase();
            const rows = document.querySelectorAll('#reportTableBody tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(keyword) ? '' : 'none';
            });
        }

        function exportToCSV() {
            const reports = JSON.parse(localStorage.getItem('koramil_reports') || '[]');
            if (reports.length === 0) {
                alert('Tidak ada data untuk diexport!');
                return;
            }
            let csvContent = "data:text/csv;charset=utf-8,Waktu,Nama,Pangkat,NRP,Desa,Jenis Kegiatan,Uraian\n";
            reports.forEach(r => {
                csvContent += `"${r.timestamp}","${r.nama}","${r.pangkat}","${r.nrp}","${r.desa}","${r.jenis}","${r.uraian.replace(/"/g, '""')}"\n`;
            });
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "Rekap_Laporan_Komsos_Koramil01.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
