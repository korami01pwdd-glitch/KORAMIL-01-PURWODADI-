                    <p class="text-sm text-gray-600" id="welcomeSub">Silakan input laporan harian Komsos atau tinjau rekapitulasi kegiatan.</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="switchTab('form')" id="tabBtnForm" class="bg-army-700 text-gold-500 px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-army-800 transition">
                        <i class="fa-solid fa-pen-to-square mr-1"></i> Input Laporan
                    </button>
                    <button onclick="switchTab('rekap')" id="tabBtnRekap" class="bg-gray-200 text-army-800 px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-gray-300 transition">
                        <i class="fa-solid fa-list-check mr-1"></i> Rekapitulasi Laporan
                    </button>
                </div>
            </div>

            <!-- TAB 1: FORM INPUT LAPORAN -->
            <div id="sectionForm" class="bg-white rounded-xl shadow-md p-6 border border-gray-200">
                <div class="border-b pb-4 mb-4 flex items-center justify-between">
                    <h3 class="text-lg font-bold text-army-800 uppercase flex items-center gap-2">
                        <i class="fa-solid fa-file-pen text-gold-600"></i> Form Pelaporan Komsos & Kegiatan Babinsa
                    </h3>
                    <span class="text-xs text-gray-500" id="currentDateDisplay"></span>
                </div>

                <form id="komsosForm" onsubmit="submitReport(event)" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Nama Lengkap</label>
                            <input type="text" id="inputNama" readonly class="w-full bg-gray-100 border border-gray-300 rounded-lg p-2.5 text-sm font-semibold text-gray-700">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Pangkat / NRP</label>
                            <input type="text" id="inputPangkatNrp" readonly class="w-full bg-gray-100 border border-gray-300 rounded-lg p-2.5 text-sm font-semibold text-gray-700">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Desa / Kelurahan Binaan</label>
                            <input type="text" id="inputDesa" placeholder="Contoh: Kelurahan Purwodadi" required class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-army-600 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Jenis Kegiatan</label>
                            <select id="inputJenis" required class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-army-600 focus:outline-none">
                                <option value="">-- Pilih Jenis Kegiatan --</option>
                                <option value="Komsos (Komunikasi Sosial)">Komsos (Komunikasi Sosial)</option>
                                <option value="Karya Bhakti">Karya Bhakti</option>
                                <option value="Ketahanan Pangan">Ketahanan Pangan</option>
                                <option value="Anjangsana / Silaturahmi">Anjangsana / Silaturahmi</option>
                                <option value="Monitoring Wilayah / Patmor">Monitoring Wilayah / Patmor</option>
                                <option value="Penanganan Bencana / Evakuasi">Penanganan Bencana / Evakuasi</option>
                                <option value="Lainnya">Lainnya</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Uraian / Hasil Kegiatan</label>
                        <textarea id="inputUraian" rows="4" placeholder="Tuliskan sasaran, hasil yang dicapai, dan catatan penting kegiatan..." required class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-army-600 focus:outline-none"></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Dokumentasi Foto Kegiatan</label>
                        <input type="file" id="inputFoto" accept="image/*" required onchange="previewImage(event)" class="w-full border border-gray-300 rounded-lg p-2 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-army-700 file:text-gold-500 hover:file:bg-army-800">
                        <div id="imagePreviewContainer" class="mt-3 hidden">
                            <p class="text-xs text-gray-500 mb-1">Pratinjau Foto:</p>
                            <img id="outputPreview" class="w-32 h-32 object-cover rounded-lg border-2 border-army-700 shadow">
                        </div>
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="w-full bg-army-700 hover:bg-army-800 text-gold-500 font-bold py-3 rounded-lg shadow uppercase tracking-wider text-sm transition border border-gold-500 flex items-center justify-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i> Kirim Laporan Resmi
                        </button>
                    </div>
                </form>
            </div>

            <!-- TAB 2: REKAPITULASI & MONITORING -->
            <div id="sectionRekap" class="hidden bg-white rounded-xl shadow-md p-6 border border-gray-200 space-y-4">
                <div class="flex flex-col md:flex-row justify-between items-center gap-3 border-b pb-4">
                    <h3 class="text-lg font-bold text-army-800 uppercase flex items-center gap-2">
                        <i class="fa-solid fa-database text-gold-600"></i> Rekapitulasi Laporan Koramil 01/Purwodadi
                    </h3>
                    <div class="flex gap-2 w-full md:w-auto">
                        <input type="text" id="searchKeyword" placeholder="Cari nama / desa..." onkeyup="filterReports()" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-army-600 w-full md:w-64">
                        <button onclick="exportToCSV()" class="bg-green-700 hover:bg-green-800 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1">
                            <i class="fa-solid fa-file-excel"></i> CSV
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-army-800 text-gold-500 text-xs uppercase">
                                <th class="p-3">Waktu / Tanggal</th>
                                <th class="p-3">Personil Babinsa</th>
                                <th class="p-3">Desa / Kelurahan</th>
                                <th class="p-3">Jenis Kegiatan</th>
                                <th class="p-3">Uraian</th>
                                <th class="p-3 text-center">Foto</th>
                                <th class="p-3 text-center">Aksi WA</th>
                            </tr>
                        </thead>
                        <tbody id="reportTableBody" class="divide-y divide-gray-200 text-xs text-gray-700">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </main>

    <!-- FOOTER -->
    <footer class="bg-army-900 text-gray-400 py-4 mt-10 border-t border-army-700 text-center text-xs">
        <p>© 2026 Koramil 01/Purwodadi • Kodim 0717/Grobogan. All Rights Reserved.</p>
        <p class="text-gold-500 mt-1 font-mono">koramil01purwodadi.my.id</p>
